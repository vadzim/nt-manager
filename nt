#!/usr/bin/env bash

set -euo pipefail

# Parse --home option first
NT_HOME_OVERRIDE=""
for arg in "$@"; do
    if [[ "$arg" =~ ^--home=(.+)$ ]]; then
        NT_HOME_OVERRIDE="${BASH_REMATCH[1]}"
        break
    fi
done

NT_HOME="${NT_HOME_OVERRIDE:-${NT_HOME:-${HOME}/.local/nt}}"
NT_NODES="${NT_HOME}/node"
NT_TOOLS="${NT_HOME}/tools"
NT_BIN="${NT_HOME}/bin"
NT_INTERNAL="${NT_HOME}/.internal"

# Detect download tool
if command -v curl >/dev/null 2>&1; then
    DOWNLOAD_CMD="curl -fsSL"
elif command -v wget >/dev/null 2>&1; then
    DOWNLOAD_CMD="wget -qO-"
else
    echo "nt: curl or wget is required"
    exit 1
fi

__nt_parse_pkg_spec() {
    local spec="$1"
    local pkg_name pkg_ver dir_name

    if [[ "$spec" =~ ^@(.+)$ ]]; then
        local without_at="${BASH_REMATCH[1]}"
        if [[ "$without_at" =~ ^([^@]+)@(.+)$ ]]; then
            pkg_name="@${BASH_REMATCH[1]}"
            pkg_ver="${BASH_REMATCH[2]}"
        else
            pkg_name="@${without_at}"
            pkg_ver=""
        fi
        dir_name="${pkg_name#@}"
        dir_name="${dir_name//\//__}"
    else
        if [[ "$spec" =~ ^([^@]+)@(.+)$ ]]; then
            pkg_name="${BASH_REMATCH[1]}"
            pkg_ver="${BASH_REMATCH[2]}"
        else
            pkg_name="$spec"
            pkg_ver=""
        fi
        dir_name="$pkg_name"
    fi

    echo "$pkg_name"
    echo "$pkg_ver"
    echo "$dir_name"
}

__nt_ensure_bootstrap_node() {
    local bootstrap_node="${NT_INTERNAL}/node"
    local bootstrap_bin="${bootstrap_node}/bin/node"
    
    # Check if we need to update (check once per day)
    local update_marker="${bootstrap_node}/.last_check"
    local should_update=false
    
    if [[ ! -x "$bootstrap_bin" ]]; then
        should_update=true
    elif [[ -f "$update_marker" ]]; then
        local last_check
        last_check=$(cat "$update_marker" 2>/dev/null || echo "0")
        local now
        now=$(date +%s)
        local day_ago=$((now - 86400))
        
        if [[ "$last_check" -lt "$day_ago" ]]; then
            should_update=true
        fi
    else
        should_update=true
    fi
    
    if [[ "$should_update" == "true" ]]; then
        echo "→ checking for LTS Node.js updates..."
        
        # Get latest LTS version
        local lts_version
        lts_version=$($DOWNLOAD_CMD "https://nodejs.org/dist/index.json" | grep -oP '\{"version":"v\K[0-9]+\.[0-9]+\.[0-9]+(?=.*"lts":"[^f])' | head -1)
        
        if [[ -z "$lts_version" ]]; then
            if [[ -x "$bootstrap_bin" ]]; then
                echo "  (using existing bootstrap node)"
                export PATH="${bootstrap_node}/bin:${PATH}"
                return 0
            fi
            echo "nt: failed to resolve LTS version"
            return 1
        fi
        
        # Check if already installed
        local current_version=""
        if [[ -x "$bootstrap_bin" ]]; then
            current_version=$("$bootstrap_bin" --version 2>/dev/null | sed 's/^v//')
        fi
        
        if [[ "$current_version" == "$lts_version" ]]; then
            echo "  ✓ bootstrap node@${lts_version} (up to date)"
            date +%s > "$update_marker"
            export PATH="${bootstrap_node}/bin:${PATH}"
            return 0
        fi
        
        # Download and install
        local os arch
        os=$(uname -s | tr '[:upper:]' '[:lower:]')
        arch=$(uname -m)
        
        case "$arch" in
            x86_64) arch="x64" ;;
            aarch64|arm64) arch="arm64" ;;
            armv7l) arch="armv7l" ;;
            *) echo "nt: unsupported architecture: $arch"; return 1 ;;
        esac
        
        case "$os" in
            linux|darwin) ;;
            *) echo "nt: unsupported OS: $os"; return 1 ;;
        esac
        
        local node_tarball="node-v${lts_version}-${os}-${arch}.tar.xz"
        local node_url="https://nodejs.org/dist/v${lts_version}/${node_tarball}"
        
        echo "→ downloading bootstrap node@${lts_version}..."
        
        local temp_dir
        temp_dir=$(mktemp -d)
        
        if ! $DOWNLOAD_CMD "$node_url" | tar -xJ -C "$temp_dir" --strip-components=1; then
            echo "nt: failed to download or extract bootstrap Node.js"
            rm -rf "$temp_dir"
            return 1
        fi
        
        rm -rf "$bootstrap_node"
        mkdir -p "${NT_INTERNAL}"
        mv "$temp_dir" "$bootstrap_node" || {
            echo "nt: failed to move bootstrap node"
            rm -rf "$temp_dir"
            return 1
        }
        
        # Verify installation
        if [[ ! -x "${bootstrap_node}/bin/node" ]]; then
            echo "nt: bootstrap node installation incomplete"
            rm -rf "$bootstrap_node"
            return 1
        fi
        
        date +%s > "$update_marker"
        
        echo "  ✓ bootstrap node@${lts_version} installed"
    fi
    
    export PATH="${bootstrap_node}/bin:${PATH}"
}

__nt_ensure_node() {
    local spec="$1"
    local node_dir="${NT_NODES}/${spec}"

    # If specific version requested, use npm to install it
    __nt_ensure_bootstrap_node || return 1
    
    if [[ -x "${node_dir}/bin/node" ]]; then
        export PATH="${node_dir}/bin:${PATH}"
        return 0
    fi

    echo "→ installing node@${spec} via npm..."
    
    mkdir -p "$node_dir"
    
    if ! npm install --prefix "$node_dir" "node@${spec}" "npm@latest" --no-save --no-package-lock; then
        echo "nt: failed to install node@${spec}"
        rm -rf "$node_dir"
        return 1
    fi
    
    # npm installs binaries in node_modules/.bin/
    local installed_node="${node_dir}/node_modules/.bin/node"
    
    if [[ ! -x "$installed_node" ]]; then
        echo "nt: node@${spec} installation incomplete"
        rm -rf "$node_dir"
        return 1
    fi
    
    # Create bin directory and symlink
    mkdir -p "${node_dir}/bin"
    ln -sf "../node_modules/.bin/node" "${node_dir}/bin/node"
    ln -sf "../node_modules/.bin/npm" "${node_dir}/bin/npm"
    ln -sf "../node_modules/.bin/npx" "${node_dir}/bin/npx" 2>/dev/null || true

    export PATH="${node_dir}/bin:${PATH}"

    local actual_version
    actual_version=$("${node_dir}/bin/node" --version 2>/dev/null | sed 's/^v//')
    echo "  ✓ node@${actual_version} ready"
}

__nt_cleanup_wrappers() {
    local tool_dir="$1"

    [[ ! -d "$NT_BIN" ]] && return 0

    for f in "$NT_BIN"/*; do
        [[ ! -f "$f" ]] && continue
        if grep -qF "$tool_dir" "$f" 2>/dev/null; then
            rm -f "$f"
        fi
    done
    
    return 0
}

__nt_recreate_all_wrappers() {
    if [[ ! -d "$NT_TOOLS" ]]; then
        return 0
    fi

    local tools=("$NT_TOOLS"/*)
    if [[ ${#tools[@]} -eq 0 ]] || [[ ! -d "${tools[0]}" ]]; then
        return 0
    fi

    for tool_dir in "${tools[@]}"; do
        local dir_name
        dir_name=$(basename "$tool_dir")
        
        local node_spec
        node_spec=$(cat "${tool_dir}/.node-version" 2>/dev/null || echo "")
        
        local pkg_spec
        pkg_spec=$(cat "${tool_dir}/.package-spec" 2>/dev/null || echo "$dir_name")
        
        local parsed
        readarray -t parsed < <(__nt_parse_pkg_spec "$pkg_spec")
        local pkg_name="${parsed[0]}"
        
        local node_dir
        if [[ -n "$node_spec" ]]; then
            node_dir="${NT_NODES}/${node_spec}"
        else
            node_dir="${NT_INTERNAL}/node"
        fi
        
        if [[ -x "${node_dir}/bin/node" ]]; then
            __nt_create_wrappers "$node_dir" "$tool_dir" "$pkg_name" >/dev/null || true
        fi
    done
    
    return 0
}

__nt_create_wrappers() {
    local node_dir="$1"
    local tool_dir="$2"
    local pkg_name="$3"

    local pkg_json="${tool_dir}/node_modules/${pkg_name}/package.json"
    local count=0

    if [[ ! -f "$pkg_json" ]]; then
        echo "nt: warning — package.json not found at $pkg_json"
        return
    fi

    local bin_entries
    bin_entries=$("${node_dir}/bin/node" -e "
const p = require('${pkg_json}');
const b = p.bin;
if (!b) process.exit(0);
const obj = typeof b === 'string' ? {[p.name]: b} : b;
Object.entries(obj).forEach(([n, v]) => console.log(n + '\t' + v));
" 2>/dev/null || true)

    mkdir -p "$NT_BIN"

    while IFS=$'\t' read -r bin_name bin_rel; do
        [[ -z "$bin_name" ]] && continue

        local bin_abs="${tool_dir}/node_modules/${pkg_name}/${bin_rel}"
        local wrapper="${NT_BIN}/${bin_name}"

        cat > "$wrapper" <<EOF
#!/usr/bin/env bash
# nt-tool: ${tool_dir}
export PATH="${node_dir}/bin:\$PATH"
exec "${bin_abs}" "\$@"
EOF

        chmod +x "$wrapper"
        ((count++))
    done <<< "$bin_entries"

    echo "$count"
}

__nt_install() {
    local node_spec=""
    local pkg_spec=""

    for arg in "$@"; do
        if [[ "$arg" =~ ^--node=(.+)$ ]]; then
            node_spec="${BASH_REMATCH[1]}"
        elif [[ "$arg" =~ ^--home=(.+)$ ]]; then
            : # already parsed at top level
        elif [[ ! "$arg" =~ ^- ]]; then
            pkg_spec="$arg"
        fi
    done

    if [[ -z "$pkg_spec" ]]; then
        echo "Usage: nt install [--home=<dir>] [--node=<version>] <package>[@version]"
        return 1
    fi

    local parsed
    readarray -t parsed < <(__nt_parse_pkg_spec "$pkg_spec")
    local pkg_name="${parsed[0]}"
    local pkg_ver="${parsed[1]}"
    local dir_name="${parsed[2]}"

    local install_spec
    if [[ -z "$pkg_ver" ]]; then
        install_spec="${pkg_name}@latest"
    else
        install_spec="${pkg_name}@${pkg_ver}"
    fi

    # Use specific Node version or bootstrap
    local node_dir
    local use_bootstrap=false
    if [[ -n "$node_spec" ]] && [[ "$node_spec" != "lts" ]] && [[ "$node_spec" != "bootstrap" ]]; then
        __nt_ensure_node "$node_spec" || return 1
        node_dir="${NT_NODES}/${node_spec}"
    else
        __nt_ensure_bootstrap_node || return 1
        node_dir="${NT_INTERNAL}/node"
        use_bootstrap=true
    fi

    local tool_dir="${NT_TOOLS}/${dir_name}"

    if [[ -d "$tool_dir" ]]; then
        __nt_cleanup_wrappers "$tool_dir"
        rm -rf "$tool_dir"
    fi

    mkdir -p "$tool_dir"
    if [[ "$use_bootstrap" == "false" ]]; then
        echo "$node_spec" > "${tool_dir}/.node-version"
    fi
    echo "$pkg_spec" > "${tool_dir}/.package-spec"

    echo "→ installing ${install_spec}..."

    set +e
    "${node_dir}/bin/npm" install --prefix "$tool_dir" "$install_spec"
    local npm_exit=$?
    set -e

    if [[ $npm_exit -ne 0 ]]; then
        echo "nt: npm install failed"
        rm -rf "$tool_dir"
        return 1
    fi

    # Check if package was actually installed
    if [[ ! -d "${tool_dir}/node_modules" ]] || [[ -z "$(ls -A "${tool_dir}/node_modules" 2>/dev/null)" ]]; then
        echo "nt: package not found or installation incomplete"
        rm -rf "$tool_dir"
        return 1
    fi

    local count
    count=$(__nt_create_wrappers "$node_dir" "$tool_dir" "$pkg_name")

    echo "✓ ${install_spec} installed — ${count} bin(s) in ${NT_BIN}"

    if [[ ":$PATH:" != *":${NT_BIN}:"* ]]; then
        echo "  ⚠  add to ~/.bashrc or ~/.zshrc:"
        echo "     export PATH=\"${NT_BIN}:\$PATH\""
    fi
}

__nt_remove() {
    local dir_name="$1"

    if [[ -z "$dir_name" ]]; then
        echo "Usage: nt remove <package>"
        return 1
    fi

    local parsed
    readarray -t parsed < <(__nt_parse_pkg_spec "$dir_name")
    dir_name="${parsed[2]}"
    local tool_dir="${NT_TOOLS}/${dir_name}"

    if [[ ! -d "$tool_dir" ]]; then
        echo "nt: ${dir_name} is not installed"
        return 1
    fi

    __nt_cleanup_wrappers "$tool_dir"
    rm -rf "$tool_dir"

    echo "✓ ${dir_name} removed"
    
    # Recreate all wrappers to resolve potential conflicts
    __nt_recreate_all_wrappers
}

__nt_update() {
    local force=false
    if [[ "${1:-}" == "--force" ]]; then
        force=true
        shift
    fi

    if [[ ! -d "$NT_TOOLS" ]]; then
        echo "nothing installed"
        return
    fi

    local tools=("$NT_TOOLS"/*/)
    if [[ ${#tools[@]} -eq 0 ]] || [[ ! -d "${tools[0]}" ]]; then
        echo "nothing installed"
        return
    fi

    for tool_dir in "${tools[@]}"; do
        local dir_name
        dir_name=$(basename "$tool_dir")
        local node_spec
        node_spec=$(cat "${tool_dir}/.node-version" 2>/dev/null || echo "")
        local pkg_spec
        pkg_spec=$(cat "${tool_dir}/.package-spec" 2>/dev/null || echo "$dir_name")

        echo ""
        echo "━━ ${pkg_spec} (node@${node_spec:-internal})"
        
        if [[ "$force" == "false" ]]; then
            # Check if update is available
            local parsed
            readarray -t parsed < <(__nt_parse_pkg_spec "$pkg_spec")
            local pkg_name="${parsed[0]}"
            local pkg_version="${parsed[1]}"
            
            # Get installed version
            local installed_version
            if [[ -f "${tool_dir}/node_modules/${pkg_name}/package.json" ]]; then
                installed_version=$(grep -oP '"version":\s*"\K[^"]+' "${tool_dir}/node_modules/${pkg_name}/package.json" | head -1)
            else
                installed_version="unknown"
            fi
            
            # Get latest version from npm (use bootstrap node if needed)
            if [[ -z "$node_spec" ]]; then
                __nt_ensure_bootstrap_node
                export PATH="${NT_INTERNAL}/node/bin:${PATH}"
            else
                __nt_ensure_node "$node_spec"
            fi
            
            local latest_version
            latest_version=$(npm view "${pkg_name}@${pkg_version}" version 2>/dev/null || echo "")
            
            if [[ -z "$latest_version" ]]; then
                echo "→ cannot check version, skipping"
                continue
            fi
            
            if [[ "$installed_version" == "$latest_version" ]]; then
                echo "→ already up-to-date (${installed_version})"
                continue
            fi
            
            echo "→ update available: ${installed_version} → ${latest_version}"
        else
            echo "→ forcing reinstall"
        fi
        
        if [[ -n "$node_spec" ]]; then
            __nt_install --node="$node_spec" "$pkg_spec"
        else
            __nt_install "$pkg_spec"
        fi
    done
}

__nt_list() {
    if [[ ! -d "$NT_TOOLS" ]]; then
        echo "nothing installed"
        return
    fi

    local tools=("$NT_TOOLS"/*/)
    if [[ ${#tools[@]} -eq 0 ]] || [[ ! -d "${tools[0]}" ]]; then
        echo "nothing installed"
        return
    fi

    for tool_dir in "${tools[@]}"; do
        local dir_name
        dir_name=$(basename "$tool_dir")
        local node_spec
        node_spec=$(cat "${tool_dir}/.node-version" 2>/dev/null || echo "")
        local pkg_spec
        pkg_spec=$(cat "${tool_dir}/.package-spec" 2>/dev/null || echo "?")
        echo "  ${pkg_spec} (node@${node_spec:-internal})"
    done
}

case "${1:-}" in
    install)
        shift
        __nt_install "$@"
        ;;
    remove|rm)
        shift
        __nt_remove "$@"
        ;;
    update|up)
        shift
        __nt_update "$@"
        ;;
    list|ls)
        __nt_list
        ;;
    "")
        echo "Usage:"
        echo "  nt install [--home=<dir>] [--node=<version>] <package>[@version]"
        echo "  nt remove <package>"
        echo "  nt update [--force]"
        echo "  nt list"
        echo ""
        echo "Options:"
        echo "  --home=<dir>     Installation directory (default: \$NT_HOME or ~/.local/nt)"
        echo "  --node=<version> Node.js version (default: latest LTS)"
        echo "  --force          Force reinstall all packages (for update command)"
        ;;
    *)
        echo "nt: unknown command '$1'"
        exit 1
        ;;
esac
